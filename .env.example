# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=domain_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
# Reserved for future non-auth signing needs. JWT signing uses AUTH__SECRET_KEY
# below; this value is not read by app/core/config.py.
SECRET_KEY=

# ---------------------------------------------------------------------------
# Nested settings (BRD AR-4). Group and field are joined by a double underscore
# (env_nested_delimiter="__"): e.g. LLM__MODEL sets settings.llm.model. Every
# value has a safe default in app/core/config.py; override per environment here.
# NEVER commit real API keys or secrets (constraint C6) -- leave them blank.
# ---------------------------------------------------------------------------

# PostgreSQL connection for the application at runtime (FR-8 persistence).
# Leave blank in development and the app holds user identity and object ownership
# in memory, logging a warning -- convenient without a database running, but those
# records are lost on restart. With ENVIRONMENT=production the app REFUSES TO
# START unless this is set, so an authorization decision is never served from a
# store that forgets. A plain postgresql:// URL is rewritten to the async driver.
DATABASE__URL=
# DATABASE__URL=postgresql://postgres:postgres@localhost:5432/domain_copilot
DATABASE__ECHO=false

# Authentication & RBAC (FR-8). The two blank values below have NO defaults in
# app/core/config.py, which is deliberate -- a default signing secret would be a
# committed credential shared by every deployment that forgot to override it.
#
# AUTH__SECRET_KEY: HMAC signing key, 32+ characters. Leave blank in development
# and the app generates a throwaway secret per process (tokens do not survive a
# restart) and logs a warning. With ENVIRONMENT=production the app REFUSES TO
# START unless this is set. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET_KEY=
AUTH__ALGORITHM=HS256
AUTH__ISSUER=domain-copilot
AUTH__AUDIENCE=domain-copilot-api
AUTH__ACCESS_TOKEN_TTL_SECONDS=3600
AUTH__BCRYPT_ROUNDS=12

# Demo accounts -- DEVELOPMENT ONLY. Seeds analyst@example.com,
# reviewer@example.com and admin@example.com (one per role) on API startup, and
# via `python scripts/seed-demo-accounts.py`. Seeding is idempotent, is skipped
# entirely when ENVIRONMENT=production, and is skipped with a warning while
# AUTH__DEMO_PASSWORD is blank -- so a fresh checkout has no usable login until
# you choose a password here. Minimum 12 characters. These are NOT production
# credentials; never reuse a real password.
AUTH__SEED_DEMO_ACCOUNTS=true
AUTH__DEMO_PASSWORD=

# LLM provider (chat/completion) -- adapter lands in #7
LLM__PROVIDER=groq
# Transient-failure fallback for chat (AR-2c). Leave blank to disable fallback;
# a value equal to LLM__PROVIDER is ignored (primary only).
LLM__FALLBACK=ollama
LLM__MODEL=llama-3.1-8b-instant
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=1024
LLM__TIMEOUT_SECONDS=60
LLM__API_KEY=

# Embedding provider -- adapter lands in #7
EMBEDDING__PROVIDER=sentence_transformers
EMBEDDING__MODEL=all-MiniLM-L6-v2
EMBEDDING__DIMENSIONS=384
EMBEDDING__BATCH_SIZE=32

# Async job queue (T7) -- broker adapter lands in #20
QUEUE__BROKER_URL=redis://localhost:6379/0
QUEUE__RESULT_BACKEND=redis://localhost:6379/1
QUEUE__DEFAULT_QUEUE=default
QUEUE__VISIBILITY_TIMEOUT_SECONDS=3600

# Dense retrieval tuning -- vector store adapter lands in #9
RETRIEVAL__TOP_K=5
RETRIEVAL__SCORE_THRESHOLD=0.0
RETRIEVAL__MAX_CONTEXT_CHUNKS=12

# Agent orchestration guardrails (SDD A.5.2)
LIMITS__MAX_ITERATIONS=10
LIMITS__PER_STEP_TIMEOUT_SECONDS=60

# Retry-with-backoff policy (SDD A.5.2)
RETRY__MAX_RETRIES=3
RETRY__BACKOFF_BASE_SECONDS=0.5
RETRY__BACKOFF_MULTIPLIER=2.0
RETRY__MAX_BACKOFF_SECONDS=30.0

# Versioned prompt artifacts (AR-4)
PROMPTS__DIRECTORY=prompts
PROMPTS__STRICT=true
